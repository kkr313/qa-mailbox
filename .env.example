# Secret used to sign session tokens (32+ chars). Generate with: openssl rand -hex 32
JWT_SECRET=

# Shared login - same credentials for the whole QA team. Aliases are created inside the app.
QA_USERS=qa:ChangeMe123

# The shared QA mailbox. Aliases are built as <local>+<alias>@<domain>
MAILBOX_ADDRESS=only4qause@gmail.com

# Google OAuth client (type: Web application) from https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed locally when running: npm run gmail:auth
GOOGLE_REDIRECT_URI=http://localhost:4213/oauth2callback

# Obtained once by running: npm run gmail:auth
GOOGLE_REFRESH_TOKEN=
DEV_API_PORT=4213
